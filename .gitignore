# ============================================================
# PEATFR-PYQT :: .gitignore
# Comprehensive ignore rules untuk Python + FastAPI + PyQt6
# + Anaconda + VSCode + Windows + Data Lokal
# ============================================================

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# ----------------------------
# Virtual Environment / Conda
# ----------------------------
venv/
ENV/
env/
.venv/
*.venv
peatfr_env/
.conda/
.condarc

# ----------------------------
# Testing & Coverage
# ----------------------------
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# ----------------------------
# Jupyter Notebook (jika dipakai eksperimen)
# ----------------------------
.ipynb_checkpoints
profile_default/
ipython_config.py

# ----------------------------
# PyQt6 / Qt
# ----------------------------
*.qm
*.qrc
*.ui
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
build-*
.qmake.stash

# ----------------------------
# FastAPI / Server
# ----------------------------
*.pid
uvicorn.log
server.log
supervisord.log

# ----------------------------
# Environment Variables (RAHASIA!)
# ----------------------------
.env
.env.local
.env.*.local
*.env
!*.env.example

# ----------------------------
# Database & Data Lokal
# ----------------------------
# Data yang tidak boleh di-commit (berisi data lapangan riil)
server/data/database_gambut.csv
server/data/config.json
server/data/*.log
data/database_gambut.csv
data/config.json
data/template_input.xlsx
data/*.xlsx
data/*.csv
!data/sample_satellite.csv   # file dummy satelit boleh di-commit

# ----------------------------
# PostgreSQL (untuk roadmap migrasi)
# ----------------------------
pgdata/
*.pgdump
*.sql.gz

# ----------------------------
# Docker (untuk roadmap kontainerisasi)
# ----------------------------
*.dockerignore.bak
docker-compose.override.yml

# ----------------------------
# Machine Learning Models (file besar, jangan di-commit)
# ----------------------------
*.h5
*.keras
*.pkl
*.joblib
*.onnx
*.pt
*.pth
models/
checkpoints/
runs/

# ----------------------------
# Logs & Temp
# ----------------------------
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ----------------------------
# VSCode
# ----------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ----------------------------
# PyCharm / JetBrains
# ----------------------------
.idea/
*.iml
*.iws
out/
.idea_modules/

# ----------------------------
# OS Windows / macOS / Linux
# ----------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
fseventsd

# ----------------------------
# Build hasil PyInstaller / cx_Freeze
# ----------------------------
*.spec
build/
dist/
!scripts/*.spec