# ============================================================
# GAMBUT FR — Environment Template
# ============================================================
# Copy file ini menjadi .env lalu isi nilai yang benar.
# JANGAN commit file .env ke Git!

# ===== SERVER =====
PEATFR_SECRET_KEY=REPLACE_WITH_SECRET_MIN_32_CHARS
CORS_ORIGINS=*
HOST=0.0.0.0
PORT=8000
GAMBUT_DATA_DIR=./server/data
JWT_EXPIRE_MINUTES=480

# ===== CLIENT =====
GAMBUT_SERVER_URL=http://127.0.0.1:8000
GAMBUT_REQUEST_TIMEOUT=15

# ===== TELEGRAM ALERT =====
# 1. Chat @BotFather di Telegram → /newbot → dapat BOT_TOKEN
# 2. Chat @userinfobot → dapat CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ===== NASA FIRMS (SATELIT) =====
# Daftar gratis: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_API_KEY=

# ===== SCHEDULER =====
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_HOURS=6

# ===== CLOUDFLARE TUNNEL =====
CLOUDFLARED_BIN=cloudflared
CLOUDFLARED_TUNNEL=gambut-server

# ===== DEEP LEARNING =====
# pytorch (default) | tensorflow | simulation
DL_BACKEND=pytorch
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0
